@app.route("/")
def index(): return render_template_string(PAGE)

@app.route("/api")
def api_doc():
    return jsonify({
        "endpoints": {
            "GET /files": "قائمة ملفات C:\\lab",
            "GET /download?p=path": "تنزيل ملف",
            "POST /run {cmd}": "تنفيذ أمر powershell كمدير",
            "GET /repos?p=path": "قراءة مستودع idk",
            "POST /repo-write {path,content,msg}": "كتابة ملف في المستودع",
            "POST /chat {msg}": "استشارة الذكاء الاصطناعي",
            "GET /messages": "كل الرسائل",
            "GET /events": "SSE للرسائل الحية",
            "POST /dispatch {workflow}": "تشغيل GitHub Action"
        }
    })

@app.route("/files")
def files():
    out = []
    for root, _, fs in os.walk(LAB):
        for f in fs:
            p = os.path.join(root, f)
            try: out.append({"path": os.path.relpath(p, LAB), "size": os.path.getsize(p)})
            except: pass
    return jsonify(out)

@app.route("/download")
def download():
    p = request.args.get("p","")
    full = os.path.abspath(os.path.join(LAB, p))
    if not full.startswith(os.path.abspath(LAB)): return "forbidden", 403
    return send_file(full, as_attachment=True)

@app.route("/run", methods=["POST"])
def run():
    cmd = request.json.get("cmd","")
    try:
        r = subprocess.run(["powershell","-NoProfile","-Command",cmd],
                           capture_output=True, text=True, timeout=900)
        return jsonify(stdout=r.stdout, stderr=r.stderr, code=r.returncode)
    except Exception as e:
        return jsonify(stdout="", stderr=str(e), code=-1)

@app.route("/chat", methods=["POST"])
def chat():
    msg = request.json.get("msg","")
    notify("user", msg)
    listing = []
    for root,_,fs in os.walk(LAB):
        for f in fs: listing.append(os.path.relpath(os.path.join(root,f),LAB))
    if AI is None:
        reply = "[AI غير مهيأ - أضف ANTHROPIC_API_KEY في secrets]"
    else:
        try:
            resp = AI.messages.create(
                model="claude-sonnet-4-5",
                max_tokens=8000,
                system="You are a reverse-engineering assistant with full admin access to a Windows machine. Files are in C:\\lab. IDA Pro is installed. Use the HTTP tools to inspect files and run commands.",
                messages=[{"role":"user","content": f"Files:\n" + "\n".join(listing) + f"\n\nTask: {msg}"}]
            )
            reply = resp.content[0].text
        except Exception as e:
            reply = f"[AI error] {e}"
    notify("assistant", reply)
    return jsonify(reply=reply)

@app.route("/events")
def events():
    def stream():
        q = queue.Queue()
        subscribers.append(q)
        try:
            for old in messages[-50:]:
                yield f"data: {json.dumps(old)}\n\n"
            while True:
                yield f"data: {json.dumps(q.get())}\n\n"
        finally:
            if q in subscribers: subscribers.remove(q)
    return Response(stream(), mimetype="text/event-stream")

@app.route("/messages")
def get_messages(): return jsonify(messages)

@app.route("/repos")
def repos():
    if not gh: return jsonify(error="no PAT")
    repo = gh.get_repo(os.environ.get("IDK_REPO",""))
    p = request.args.get("p","")
    try:
        return jsonify([{"name":c.name,"type":c.type,"path":c.path,"size":c.size} for c in repo.get_contents(p)])
    except Exception as e:
        return jsonify(error=str(e))

@app.route("/repo-write", methods=["POST"])
def repo_write():
    if not gh: return jsonify(error="no PAT")
    repo = gh.get_repo(os.environ.get("IDK_REPO",""))
    d = request.json
    try:
        f = repo.get_contents(d["path"])
        repo.update_file(d["path"], d.get("msg","update"), d["content"], f.sha)
    except Exception:
        repo.create_file(d["path"], d.get("msg","create"), d["content"])
    return jsonify(ok=True)

@app.route("/dispatch", methods=["POST"])
def dispatch():
    if not gh: return jsonify(error="no PAT")
    repo = gh.get_repo(os.environ.get("GITHUB_REPOSITORY",""))
    wf = repo.get_workflow(request.json["workflow"])
    wf.create_dispatch(ref=request.json.get("ref","main"))
    return jsonify(ok=True)

if __name__ == "__main__":
    app.run(host="0.0.0.0", port=8000, threaded=True)
'@
          Set-Content -Path C:\server.py -Value $py -Encoding UTF8

      - name: Start server + tunnel
        shell: pwsh
        env:
          GH_PAT: ${{ secrets.GH_PAT }}
          ANTHROPIC_API_KEY: ${{ secrets.ANTHROPIC_API_KEY }}
          GITHUB_REPOSITORY: ${{ github.repository }}
          IDK_REPO: abdallh-rgx/idk
        run: |
          Start-Process python -ArgumentList "C:\server.py" -NoNewWindow -RedirectStandardOutput C:\srv.log -RedirectStandardError C:\srv.err
          Start-Sleep 6
          Start-Process C:\cloudflared.exe -ArgumentList "tunnel --url http://localhost:8000 --no-autoupdate" -RedirectStandardError C:\cf.log -NoNewWindow

          $url = ""
          for ($i=0; $i -lt 60; $i++) {
            Start-Sleep 3
            if (Test-Path C:\cf.log) {
              $c = Get-Content C:\cf.log -Raw
              if ($c -match 'https://[a-z0-9-]+\.trycloudflare\.com') {
                $url = $matches[0]
                break
              }
            }
          }
          Write-Host "============================================"
          Write-Host "PUBLIC URL: $url"
          Write-Host "============================================"
          echo "PUBLIC_URL=$url" >> $env:GITHUB_ENV

      - name: Chain next run
        shell: pwsh
        run: |
          Start-Sleep -Seconds 20100
          $body = @{ ref = "main" } | ConvertTo-Json
          Invoke-RestMethod -Method Post `
            -Uri "https://api.github.com/repos/${{ github.repository }}/actions/workflows/lab.yml/dispatches" `
            -Headers @{ Authorization = "Bearer ${{ secrets.GH_PAT }}"; Accept = "application/vnd.github+json" } `
            -Body $body -ContentType "application/json"

      - name: Keep alive
        shell: pwsh
        run: while ($true) { Start-Sleep 300 }
