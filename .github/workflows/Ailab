from flask import Flask, request, jsonify, Response, send_file, render_template_string
from github import Github
import subprocess, os, threading, queue, json, time
try:
    import anthropic
    AI = anthropic.Anthropic(api_key=os.environ.get("ANTHROPIC_API_KEY",""))
except Exception:
    AI = None

app = Flask(__name__)
LAB = r"C:\lab"
GH_PAT = os.environ.get("GH_PAT","")
gh = Github(GH_PAT) if GH_PAT else None
messages = []
subscribers = []

def notify(role, text):
    m = {"role": role, "text": text, "ts": time.time()}
    messages.append(m)
    for q in list(subscribers):
        try: q.put_nowait(m)
        except: pass

PAGE = r"""
